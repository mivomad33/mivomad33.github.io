---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import PortfolioList from '../../components/PortfolioList.astro';
import { getPortfolio } from '../../lib/portfolio';

// 포트폴리오. 모든 항목을 파일에 적은 순서대로 카드로 보여 준다.
const portfolio = await getPortfolio();
---

<BaseLayout title="포트폴리오">
  <PageTitle>포트폴리오</PageTitle>
  {
    portfolio.length > 0 ? (
      <PortfolioList items={portfolio} headingLevel={2} />
    ) : (
      <p class="text-muted">아직 항목이 없습니다.</p>
    )
  }
</BaseLayout>
