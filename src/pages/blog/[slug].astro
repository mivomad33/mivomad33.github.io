---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostDate from '../../components/PostDate.astro';
import Prose from '../../components/Prose.astro';
import { getPostsWithNeighbors } from '../../lib/blog';

// 글 보기. 제목, 게시일(수정일), 본문, 이전·다음 글 링크.
export async function getStaticPaths() {
  return (await getPostsWithNeighbors()).map(({ post, prev, next }) => ({
    params: { slug: post.id },
    props: { post, prev, next },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
// 이전 글이 위, 다음 글이 아래.
const pager = [
  prev && { post: prev, label: '이전 글', arrow: 'before' },
  next && { post: next, label: '다음 글', arrow: 'after' },
].filter((link) => !!link);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  article={{ published: post.data.date, modified: post.data.updated }}
>
  <article>
    <header class="mb-10">
      <h1 class="text-2xl leading-tight font-bold">{post.data.title}</h1>
      <p class="mt-3 flex flex-wrap gap-3 text-sm text-muted">
        <PostDate date={post.data.date} />
        {
          post.data.updated && (
            <span>
              <span class="mr-3" aria-hidden="true">
                ·
              </span>
              수정 <PostDate date={post.data.updated} />
            </span>
          )
        }
      </p>
    </header>
    <Prose><Content /></Prose>
  </article>
  {
    pager.length > 0 && (
      <nav
        aria-label="이전 글과 다음 글"
        class="mt-14 grid border-t border-dashed border-border"
      >
        {pager.map(({ post: linked, label, arrow }) => (
          <a
            href={`/blog/${linked.id}/`}
            class="group flex flex-col gap-0.5 border-b border-dashed border-border py-4 sm:flex-row sm:items-baseline sm:gap-4"
          >
            <span class="shrink-0 text-sm text-accent">
              {arrow === 'before' && (
                <span class="font-mono" aria-hidden="true">
                  ←{' '}
                </span>
              )}
              {label}
              {arrow === 'after' && (
                <span class="font-mono" aria-hidden="true">
                  {' '}
                  →
                </span>
              )}
            </span>
            <span class="group-hover:underline">{linked.data.title}</span>
          </a>
        ))}
      </nav>
    )
  }
</BaseLayout>
