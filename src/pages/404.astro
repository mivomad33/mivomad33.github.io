---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import { UI, localePath } from '../lib/i18n';

// 없는 주소 안내. GitHub Pages는 404.html 하나만 보여 주므로 한국어와 영어를 함께 쓴다(변경 1).
// 방문자가 어느 언어 페이지에서 왔는지 알 수 없으므로, 두 언어의 홈 링크를 모두 둔다.
const { ko, en } = UI;
---

<BaseLayout title={ko.notFound} notFound>
  <PageTitle>{ko.notFound}</PageTitle>
  <p class="-mt-6 mb-10 text-xl leading-tight text-muted" lang="en">
    {en.notFound}
  </p>
  <p class="flex flex-wrap gap-x-6 gap-y-2">
    <a href={localePath('ko', '/')} class="text-accent hover:underline">
      {ko.goHome}
    </a>
    <a
      href={localePath('en', '/')}
      class="text-accent hover:underline"
      lang="en"
    >
      {en.goHome}
    </a>
  </p>
</BaseLayout>
