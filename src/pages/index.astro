---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSection from '../components/HomeSection.astro';
import PortfolioList from '../components/PortfolioList.astro';
import { getProfile } from '../lib/profile';
import { getRecentPortfolio } from '../lib/portfolio';

// 홈. 한 줄 소개, 최근 포트폴리오(최근 글은 6단계에서 채운다). 항목이 0개인 영역은 숨긴다.
// 한 줄 소개와 영역들을 한 격자 간격으로 쌓아, 영역이 모두 숨겨져도 빈 여백이 남지 않게 한다.
const profile = await getProfile();
const recentPortfolio = await getRecentPortfolio();
---

<BaseLayout>
  <div class="grid gap-14">
    <p class="text-xl leading-tight font-bold">
      <span class="font-mono text-accent" aria-hidden="true">&gt; </span>{
        profile.intro
      }
    </p>
    {
      recentPortfolio.length > 0 && (
        <HomeSection title="최근 포트폴리오" moreHref="/portfolio/">
          <PortfolioList items={recentPortfolio} headingLevel={3} />
        </HomeSection>
      )
    }
  </div>
</BaseLayout>
