---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EmptyNotice from '../../../components/EmptyNotice.astro';
import PageTitle from '../../../components/PageTitle.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts } from '../../../lib/blog';
import { getProfile } from '../../../lib/profile';
import { localeStaticPaths, UI, type Locale } from '../../../lib/i18n';

// 글 목록(언어마다 하나). 그 언어의 모든 글을 게시일 최신순으로 한 페이지에 보여 준다.
export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const posts = await getPosts(locale);
const profile = await getProfile(locale);
---

<BaseLayout
  locale={locale}
  title={ui.menu.blog}
  description={ui.blogDescription(profile.name)}
>
  <PageTitle>{ui.menu.blog}</PageTitle>
  {
    posts.length > 0 ? (
      <PostList locale={locale} posts={posts} headingLevel={2} />
    ) : (
      <EmptyNotice locale={locale} />
    )
  }
</BaseLayout>
