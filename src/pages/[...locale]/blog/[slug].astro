---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostDate from '../../../components/PostDate.astro';
import Prose from '../../../components/Prose.astro';
import { getPostsWithNeighbors } from '../../../lib/blog';
import { localePath, localeStaticPaths, UI } from '../../../lib/i18n';

// 글 보기(언어마다 하나). 제목, 게시일(수정일), 본문, 이전·다음 글 링크.
export async function getStaticPaths() {
  const paths = await Promise.all(
    localeStaticPaths().map(async ({ params, props: { locale } }) =>
      (await getPostsWithNeighbors(locale)).map(({ post, prev, next }) => ({
        params: { ...params, slug: post.slug },
        props: { locale, post, prev, next },
      })),
    ),
  );
  return paths.flat();
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale, post, prev, next } = Astro.props;
const ui = UI[locale];
const { Content } = await render(post);
// 이전 글이 위, 다음 글이 아래.
const pager = [
  prev && { post: prev, label: ui.prev, arrow: 'before' },
  next && { post: next, label: ui.next, arrow: 'after' },
].filter((link) => !!link);
---

<BaseLayout
  locale={locale}
  title={post.data.title}
  description={post.data.description}
  article={{ published: post.data.date, modified: post.data.updated }}
>
  <article>
    <header class="mb-10">
      <h1 class="text-2xl leading-tight font-bold">{post.data.title}</h1>
      <p class="mt-3 flex flex-wrap gap-3 text-sm text-muted">
        <PostDate date={post.data.date} />
        {
          post.data.updated && (
            <span>
              <span class="mr-3" aria-hidden="true">
                ·
              </span>
              {ui.updated} <PostDate date={post.data.updated} />
            </span>
          )
        }
      </p>
    </header>
    <Prose><Content /></Prose>
  </article>
  {
    pager.length > 0 && (
      <nav
        aria-label={ui.pagerLabel}
        class="mt-14 grid border-t border-dashed border-border"
      >
        {pager.map(({ post: linked, label, arrow }) => (
          <a
            href={localePath(locale, `/blog/${linked.slug}/`)}
            class="group flex flex-col gap-0.5 border-b border-dashed border-border py-4 sm:flex-row sm:items-baseline sm:gap-4"
          >
            <span class="shrink-0 text-sm text-accent">
              {arrow === 'before' && (
                <span class="font-mono" aria-hidden="true">
                  ←{' '}
                </span>
              )}
              {label}
              {arrow === 'after' && (
                <span class="font-mono" aria-hidden="true">
                  {' '}
                  →
                </span>
              )}
            </span>
            <span class="group-hover:underline">{linked.data.title}</span>
          </a>
        ))}
      </nav>
    )
  }
</BaseLayout>
