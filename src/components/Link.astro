---
import type { HTMLAttributes } from 'astro/types';
import { localeOfPath } from '../lib/i18n';
import {
  EXTERNAL_ICON_CLASS,
  EXTERNAL_LABEL_CLASS,
  EXTERNAL_LINK_ATTRS,
  WORD_JOINER,
  isExternalUrl,
  newTabLabel,
} from '../lib/link';

// 링크(변경 2). 주소를 보고 외부 링크면 새 탭 속성과 아이콘(화면 낭독기에는 "새 탭에서 열림")을 붙이고, 아니면 일반 <a>를 만든다.
// 데이터 파일의 링크처럼 외부인지 사이트 안인지 미리 알 수 없는 주소는 이 컴포넌트로 쓴다. 규칙은 src/lib/link.ts에 있다.
// 클래스(색, hover 등)는 쓰는 곳이 넘긴다.
interface Props extends HTMLAttributes<'a'> {
  href: string;
}

const { href, ...attrs } = Astro.props;
const external = isExternalUrl(href);
// 아이콘이 화면 낭독기에 읽히는 문구는 페이지 언어를 따른다.
const locale = localeOfPath(Astro.url.pathname);
---

{
  external ? (
    <a href={href} {...EXTERNAL_LINK_ATTRS} {...attrs}>
      <span class={EXTERNAL_LABEL_CLASS}>
        <slot />
      </span>
      {WORD_JOINER}
      <span
        class={EXTERNAL_ICON_CLASS}
        role="img"
        aria-label={newTabLabel(locale)}
      />
    </a>
  ) : (
    <a href={href} {...attrs}>
      <slot />
    </a>
  )
}
