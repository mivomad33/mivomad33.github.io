---
import type { Post } from '../lib/blog';
import type { Locale } from '../lib/i18n';
import PostListItem from './PostListItem.astro';

// 글 목록. 글 목록 페이지와 홈의 최근 글이 같이 쓴다.
interface Props {
  locale: Locale;
  posts: Post[];
  headingLevel: 2 | 3;
}

const { locale, posts, headingLevel } = Astro.props;
---

<ul class="grid gap-6">
  {
    posts.map((post) => (
      <PostListItem locale={locale} post={post} headingLevel={headingLevel} />
    ))
  }
</ul>
